# Dockerfile.dashboard -- realcode dashboard (Next.js)
FROM node:20-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY src/dashboard/ ./src/dashboard/

RUN cd src/dashboard && npx next build

ENV PORT=3000
EXPOSE 3000

CMD ["sh", "-c", "cd src/dashboard && npx next start -p 3000"]
