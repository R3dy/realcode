{
  "$ref": "#/definitions/ShipOutput",
  "definitions": {
    "ShipOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "ship"
        },
        "status": {
          "type": "string",
          "enum": [
            "shipped",
            "ship_failed"
          ]
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "artifact": {
          "type": "object",
          "properties": {
            "live_url": {
              "type": "string",
              "format": "uri"
            },
            "repo_url": {
              "type": "string",
              "format": "uri"
            },
            "launch_checklist_md": {
              "type": "string",
              "minLength": 1
            },
            "metrics_dashboard_md": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "launch_checklist_md",
            "metrics_dashboard_md"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}