{
  "$ref": "#/definitions/FrameOutput",
  "definitions": {
    "FrameOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "frame"
        },
        "status": {
          "type": "string",
          "enum": [
            "framed",
            "framing_failed"
          ]
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "artifact": {
          "type": "object",
          "properties": {
            "project_md": {
              "type": "string",
              "minLength": 1
            },
            "project_type": {
              "type": "string",
              "enum": [
                "saas",
                "hobby",
                "cli",
                "library",
                "api-service",
                "internal-tool",
                "static-site",
                "agentic-harness"
              ]
            },
            "has_ui": {
              "type": "boolean"
            },
            "is_sellable": {
              "type": "boolean"
            }
          },
          "required": [
            "project_md",
            "project_type",
            "has_ui",
            "is_sellable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}