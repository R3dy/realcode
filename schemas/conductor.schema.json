{
  "$ref": "#/definitions/ConductorOutput",
  "definitions": {
    "ConductorOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "conductor"
        },
        "status": {
          "type": "string",
          "enum": [
            "classified_new",
            "classified_change",
            "conductor_failed"
          ]
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0,
          "default": 0
        },
        "artifact": {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "enum": [
                "new",
                "change"
              ]
            },
            "target_project": {
              "type": [
                "string",
                "null"
              ]
            },
            "flow_type": {
              "type": "string",
              "enum": [
                "full",
                "agile"
              ]
            },
            "clean_idea": {
              "type": "string",
              "minLength": 1
            },
            "classification_reasoning": {
              "type": "string",
              "default": ""
            },
            "available_projects": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "required": [
            "intent",
            "flow_type",
            "clean_idea"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}