{
  "$ref": "#/definitions/WorkerOutput",
  "definitions": {
    "WorkerOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "build_worker"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failed",
            "escalated"
          ]
        },
        "artifact": {
          "type": "object",
          "properties": {
            "story_id": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "success",
                "failed"
              ]
            },
            "failure_type": {
              "type": "string",
              "enum": [
                "environment",
                "implementation"
              ]
            },
            "failure_description": {
              "type": "string"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "commits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sha": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "sha",
                  "message"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "test_output": {
              "type": "string",
              "default": ""
            },
            "test_passed": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "test_failed": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "notes": {
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "story_id",
            "result",
            "branch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}