{
  "$ref": "#/definitions/ChangeOutput",
  "definitions": {
    "ChangeOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "change"
        },
        "status": {
          "type": "string",
          "enum": [
            "shipped",
            "change_failed"
          ]
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "artifact": {
          "type": "object",
          "properties": {
            "changes_summary": {
              "type": "string",
              "minLength": 1
            },
            "files_modified": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "files_created": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "tests_run": {
              "type": "boolean",
              "default": false
            },
            "tests_passed": {
              "type": "boolean",
              "default": false
            },
            "test_output": {
              "type": "string",
              "default": ""
            },
            "commit_sha": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit_message": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_project": {
              "type": "string"
            }
          },
          "required": [
            "changes_summary",
            "target_project"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}