{
  "$ref": "#/definitions/SpecOutput",
  "definitions": {
    "SpecOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "spec"
        },
        "status": {
          "type": "string",
          "enum": [
            "specified",
            "spec_failed"
          ]
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "artifact": {
          "type": "object",
          "properties": {
            "epics_md": {
              "type": "string",
              "minLength": 1
            },
            "backlog_md": {
              "type": "string",
              "minLength": 1
            },
            "dependency_graph": {
              "type": "string",
              "minLength": 1
            },
            "story_count": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "stories": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "epic": {
                    "type": "string",
                    "default": ""
                  },
                  "acceptance_criteria": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  }
                },
                "required": [
                  "id",
                  "title",
                  "acceptance_criteria"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "epics_md",
            "story_count",
            "stories"
          ],
          "additionalProperties": false,
          "description": "backlog_md + dependency_graph are optional: the spec agent (glm-5.2) unreliably drops these documentation-only markdown fields while reliably emitting epics_md + the structured stories array (the only field the build loop consumes — see src/engine/build-loop.ts). Making them optional prevents spec-stage validation failures on otherwise-valid artifacts (4+ historical runs failed at spec for this exact reason). They are still validated when present."
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}