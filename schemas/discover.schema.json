{
  "$ref": "#/definitions/DiscoverOutput",
  "definitions": {
    "DiscoverOutput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_verdict": {
          "type": "string",
          "enum": [
            "pass",
            "needs_changes",
            "escalate"
          ]
        },
        "gate_notes": {
          "type": "string",
          "default": ""
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "estimated_cost_usd"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "const": "discover"
        },
        "status": {
          "type": "string",
          "enum": [
            "discovered",
            "discovery_failed"
          ]
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "artifact": {
          "type": "object",
          "properties": {
            "discovery_md": {
              "type": "string",
              "minLength": 1
            },
            "lite_mode": {
              "type": "boolean"
            },
            "failure_modes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mitigation": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "mode",
                  "mitigation"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "discovery_md",
            "lite_mode",
            "failure_modes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trace_id",
        "gate_verdict",
        "token_usage",
        "stage",
        "status",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}